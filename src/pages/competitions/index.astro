---
import { getCollection } from 'astro:content';
import EntryList from '@components/EntryList.astro';
import PageIntro from '@components/PageIntro.astro';
import BaseLayout from '@layouts/BaseLayout.astro';
import { entryHref, sortCompetitions } from '@data/utils';

const entries = sortCompetitions(await getCollection('competitions'));
const items = entries.map((entry) => ({
  title: entry.data.title,
  date: entry.data.date,
  summary: entry.data.summary,
  tags: entry.data.tags,
  cover: entry.data.cover,
  role: entry.data.role,
  outcome: entry.data.outcome,
  href: entryHref('competitions', entry.id),
  type: '竞赛与个人项目',
}));
---

<BaseLayout title="竞赛与个人项目">
  <PageIntro
    eyebrow="Competitions / Personal Projects"
    title="竞赛与个人项目"
    summary="这里集中呈现机器人竞赛、独立硬件实践和个人技术项目。项目按竞赛结果与技术代表性排序，详情页保留结构、控制、硬件和调试证据。"
  />
  <section class="section-block">
    <EntryList items={items} variant="visual" />
  </section>
</BaseLayout>
