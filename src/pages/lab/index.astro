---
import { getCollection } from 'astro:content';
import EntryList from '@components/EntryList.astro';
import PageIntro from '@components/PageIntro.astro';
import BaseLayout from '@layouts/BaseLayout.astro';
import { entryHref, sortByDate } from '@data/utils';

const entries = sortByDate(await getCollection('lab'));
const items = entries.map((entry) => ({
  title: entry.data.title,
  date: entry.data.date,
  summary: entry.data.summary,
  tags: entry.data.tags,
  cover: entry.data.cover,
  role: entry.data.role,
  outcome: entry.data.outcome,
  href: entryHref('lab', entry.id),
  type: '实验室项目',
}));
---

<BaseLayout title="实验室项目">
  <PageIntro
    eyebrow="Lab"
    title="实验室项目"
    summary="这里呈现半人形机械臂运动控制、动力学辨识和嵌入式部署推进经历，重点保留从仿真、数据采集到真机调试的完整链路。"
  />
  <section class="section-block">
    <EntryList items={items} variant="visual" />
  </section>
</BaseLayout>
