---
import { getCollection } from 'astro:content';
import PageIntro from '@components/PageIntro.astro';
import ProjectTimeline from '@components/ProjectTimeline.astro';
import BaseLayout from '@layouts/BaseLayout.astro';
import { entryHref, sortByDate } from '@data/utils';

const competitions = await getCollection('competitions');
const coursework = await getCollection('coursework');
const lab = await getCollection('lab');
const items = sortByDate([...competitions, ...coursework, ...lab]).map((entry) => {
  const kind = entry.collection;
  return {
    title: entry.data.title,
    date: entry.data.date,
    summary: entry.data.summary,
    tags: entry.data.tags,
    cover: entry.data.cover,
    role: entry.data.role,
    outcome: entry.data.outcome,
    href: entryHref(kind, entry.id),
    type: kind === 'competitions' ? '个人成果' : kind === 'coursework' ? '课程' : '实验室',
    kind,
    featured: entry.data.featured,
  };
});
---

<BaseLayout title="项目时间线">
  <PageIntro
    eyebrow="Timeline"
    title="项目时间线"
    summary="汇集网站内全部项目条目，按年份展示个人成果、实验室成果与课程成果。"
  />
  <section class="timeline-section">
    <ProjectTimeline items={items} />
  </section>
</BaseLayout>
