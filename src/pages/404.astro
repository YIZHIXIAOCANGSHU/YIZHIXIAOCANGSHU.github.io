---
import BaseLayout from '@layouts/BaseLayout.astro';
---

<BaseLayout title="页面未找到">
  <section class="section-block">
    <p class="eyebrow">404</p>
    <h1>页面未找到</h1>
    <p class="section-lead">这个页面可能已经移动。你可以回到首页，或从导航进入在线简历和项目档案。</p>
    <div class="cta-row">
      <a class="button-link" href="/">回到首页</a>
      <a class="button-link button-link--secondary" href="/projects">查看项目档案</a>
    </div>
  </section>
</BaseLayout>
