---
import { getCollection } from 'astro:content';
import EntryList from '@components/EntryList.astro';
import PageIntro from '@components/PageIntro.astro';
import BaseLayout from '@layouts/BaseLayout.astro';
import { entryHref, sortCoursework } from '@data/utils';

const entries = sortCoursework(await getCollection('coursework'));
const items = entries.map((entry) => ({
  title: entry.data.title,
  date: entry.data.date,
  summary: entry.data.summary,
  tags: entry.data.tags,
  cover: entry.data.cover,
  role: entry.data.role,
  outcome: entry.data.outcome,
  href: entryHref('coursework', entry.id),
  type: '课程项目',
}));
---

<BaseLayout title="课程项目">
  <PageIntro
    eyebrow="Coursework"
    title="课程项目"
    summary="这里整理课程中的工程项目与报告成果，覆盖控制、嵌入式、机械制造、产品设计和工程分析。列表优先展示与机器人工程链路相关的项目。"
  />
  <section class="section-block">
    <EntryList items={items} variant="visual" />
  </section>
</BaseLayout>
