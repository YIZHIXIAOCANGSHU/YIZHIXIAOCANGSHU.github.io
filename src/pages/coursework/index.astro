---
import { getCollection } from 'astro:content';
import EntryList from '@components/EntryList.astro';
import PageIntro from '@components/PageIntro.astro';
import BaseLayout from '@layouts/BaseLayout.astro';
import { entryHref, sortByDate } from '@data/utils';

const entries = sortByDate(await getCollection('coursework'));
const items = entries.map((entry) => ({
  title: entry.data.title,
  date: entry.data.date,
  summary: entry.data.summary,
  tags: entry.data.tags,
  href: entryHref('coursework', entry.id),
  type: '课程',
}));
---

<BaseLayout title="课程成果">
  <PageIntro
    eyebrow="Coursework"
    title="课程成果"
    summary="这里整理课程中的工程项目与报告成果。每个详情页按作品集叙事重写，重点说明项目目标、工作链路、关键取舍、结果图证和阶段反思。"
  />
  <section class="section-block">
    <EntryList items={items} />
  </section>
</BaseLayout>
