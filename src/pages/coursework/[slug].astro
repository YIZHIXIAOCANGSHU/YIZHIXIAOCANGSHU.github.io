---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import ContentLayout from '@layouts/ContentLayout.astro';
import { entryHref, sortByDate } from '@data/utils';

export async function getStaticPaths() {
  const entries = sortByDate(await getCollection('coursework'));
  return entries.map((entry, index) => ({
    params: { slug: entry.id },
    props: {
      entry,
      newer: index > 0 ? { title: entries[index - 1].data.title, href: entryHref('coursework', entries[index - 1].id) } : undefined,
      older: index < entries.length - 1 ? { title: entries[index + 1].data.title, href: entryHref('coursework', entries[index + 1].id) } : undefined,
    },
  }));
}

interface Props {
  entry: CollectionEntry<'coursework'>;
  newer?: { title: string; href: string };
  older?: { title: string; href: string };
}

const { entry, newer, older } = Astro.props as Props;
const { Content, headings } = await render(entry);
---

<ContentLayout
  title={entry.data.title}
  date={entry.data.date}
  summary={entry.data.summary}
  cover={entry.data.cover}
  role={entry.data.role}
  contribution={entry.data.contribution}
  outcome={entry.data.outcome}
  tech={entry.data.tech}
  tags={entry.data.tags}
  links={entry.data.links}
  collectionLabel="课程项目"
  headings={headings}
  newer={newer}
  older={older}
>
  <Content />
</ContentLayout>
