---
import { ArrowRight, Mail } from '@lucide/astro';
import { getCollection } from 'astro:content';
import BaseLayout from '@layouts/BaseLayout.astro';
import { profile } from '@data/profile';
import { collectionLabel, entryHref, sortByDate, sortCompetitions, sortCoursework } from '@data/utils';

const competitions = sortCompetitions(await getCollection('competitions'));
const coursework = sortCoursework(await getCollection('coursework'));
const lab = sortByDate(await getCollection('lab'));
const entries = [...competitions, ...coursework, ...lab];

const featuredEntries = entries
  .filter((entry) => entry.data.featured)
  .map((entry) => {
    const cover = entry.data.cover;

    if (!cover) {
      throw new Error(`Featured entry "${entry.data.title}" (${entry.collection}/${entry.id}) requires a cover image.`);
    }

    return { ...entry, data: { ...entry.data, cover } };
  })
  .sort((a, b) => (a.data.featuredOrder ?? 99) - (b.data.featuredOrder ?? 99));

const archives = [
  {
    title: collectionLabel('competitions'),
    count: competitions.length,
    href: '/competitions',
    description: '机器人竞赛、独立硬件实践与结构设计，按竞赛结果和技术代表性浏览。',
  },
  {
    title: collectionLabel('lab'),
    count: lab.length,
    href: '/lab',
    description: '半人形机械臂运动控制、动力学辨识、实时接口与真机调试。',
  },
  {
    title: collectionLabel('coursework'),
    count: coursework.length,
    href: '/coursework',
    description: '控制、嵌入式、机械制造、产品设计与工程分析课程项目。',
  },
];

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: profile.chineseName,
  alternateName: profile.name,
  url: profile.homepage,
  image: new URL(profile.avatar, Astro.site).href,
  email: `mailto:${profile.email}`,
  affiliation: {
    '@type': 'CollegeOrUniversity',
    name: '重庆大学',
  },
  knowsAbout: ['机器人运动控制', '机械结构设计', '嵌入式系统', '智能硬件项目推进'],
};
---

<BaseLayout
  description="贺禄文的机器人工程项目档案，记录机械结构、运动控制、嵌入式硬件、仿真调试与项目推进经历。"
  image="/images/lab/seven-axis/impedance-sim.jpg"
  structuredData={personSchema}
  flush
>
  <section class="portfolio-hero portfolio-hero--engineer" aria-labelledby="portfolio-title">
    <img
      class="portfolio-hero__image"
      src="/images/lab/seven-axis/impedance-sim.jpg"
      alt="七自由度机械臂阻抗控制仿真结果"
      fetchpriority="high"
    />
    <div class="portfolio-hero__scrim" aria-hidden="true"></div>
    <div class="portfolio-hero__inner">
      <p class="portfolio-hero__school">重庆大学机器人工程（明月班）本科生</p>
      <h1 id="portfolio-title">贺禄文</h1>
      <p class="portfolio-hero__role">机器人工程师 / 项目档案</p>
      <p class="portfolio-hero__lead">
        我把机械结构、运动控制、嵌入式硬件和仿真调试放进同一条工程链路，持续将机器人项目推进到可制造、可验证、可复盘的阶段。
      </p>
      <div class="portfolio-hero__signals" aria-label="工程实践方向">
        <span>机械结构与制造</span>
        <span>运动控制与仿真</span>
        <span>嵌入式与硬件</span>
        <span>系统联调与项目推进</span>
      </div>
      <div class="portfolio-hero__actions">
        <a class="button-link button-link--light" href="/projects">
          浏览项目档案
          <ArrowRight size={17} aria-hidden="true" />
        </a>
        <a class="portfolio-hero__resume-link" href="/resume">
          查看在线简历
          <ArrowRight size={17} aria-hidden="true" />
        </a>
      </div>
    </div>
    <span class="portfolio-hero__caption">
      <span>工程档案</span>
      结构、控制、硬件与调试的项目记录
    </span>
  </section>

  <div class="portfolio-content">
    <section id="selected-work" class="portfolio-section" aria-labelledby="selected-title">
      <header class="portfolio-section__head">
        <div>
          <p class="eyebrow">Selected Work</p>
          <h2 id="selected-title">代表项目</h2>
        </div>
        <p>从半人形机械臂控制与辨识，到足式机器人结构、智能车硬件和 Robomaster 整机设计，先看最能代表工程链路的项目。</p>
      </header>
      <div class="featured-work">
        {
          featuredEntries.map((entry) => (
            <article>
              <a class="featured-work__item" href={entryHref(entry.collection, entry.id)}>
                <span class="featured-work__media">
                  <img src={entry.data.cover} alt="" loading="lazy" />
                </span>
                <div class="featured-work__content">
                  <p class="featured-work__meta">
                    {collectionLabel(entry.collection)} / {entry.data.role}
                  </p>
                  <h3>{entry.data.title}</h3>
                  <p>{entry.data.contribution}</p>
                  <strong>{entry.data.outcome}</strong>
                  <span class="text-link">
                    查看项目详情
                    <ArrowRight size={16} aria-hidden="true" />
                  </span>
                </div>
              </a>
            </article>
          ))
        }
      </div>
    </section>

    <section class="portfolio-section" aria-labelledby="archive-title">
      <header class="portfolio-section__head">
        <div>
          <p class="eyebrow">Project Archive</p>
          <h2 id="archive-title">项目档案</h2>
        </div>
        <p>共 {entries.length} 个项目，按来源整理完整经历；分类页提供全部条目和详细技术证据。</p>
      </header>
      <div class="archive-list">
        {
          archives.map((archive) => (
            <a href={archive.href}>
              <span>{archive.count.toString().padStart(2, '0')}</span>
              <div>
                <strong>{archive.title}</strong>
                <p>{archive.description}</p>
              </div>
              <ArrowRight size={20} aria-hidden="true" />
            </a>
          ))
        }
      </div>
      <a class="archive-all-link" href="/projects">
        进入项目档案总览
        <ArrowRight size={17} aria-hidden="true" />
      </a>
    </section>

    <section class="portfolio-section portfolio-section--timeline" aria-labelledby="timeline-title">
      <header class="portfolio-section__head">
        <div>
          <p class="eyebrow">Engineering Timeline</p>
          <h2 id="timeline-title">从结构实践到系统调试</h2>
        </div>
        <p>按时间回看项目路径，了解机械设计、硬件实现、控制方法和项目协同如何逐步叠加。</p>
      </header>
      <a class="timeline-callout" href="/timeline">
        <span>查看完整时间线</span>
        <ArrowRight size={20} aria-hidden="true" />
      </a>
    </section>

    <footer class="portfolio-contact" aria-label="联系邮箱">
      <Mail size={16} aria-hidden="true" />
      <span>联系邮箱</span>
      <a href={`mailto:${profile.email}`}>{profile.email}</a>
    </footer>
  </div>
</BaseLayout>
