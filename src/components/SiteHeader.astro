---
import { Moon, Sun } from '@lucide/astro';
import { site } from '@data/site';

interface Props {
  currentPath: string;
}

const { currentPath } = Astro.props;
const isActive = (href: string) =>
  href === '/' ? currentPath === '/' : currentPath === href || currentPath.startsWith(`${href}/`);
---

<header class="site-header">
  <a class="site-brand" href="/" aria-label="回到首页">
    <span class="brand-mark">贺</span>
    <span>
      <strong>贺禄文</strong>
      <small>机器人工程师 / 项目档案</small>
    </span>
  </a>
  <nav class="site-nav" aria-label="主导航">
    {
      site.nav.map((item) => (
        <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
          {item.label}
        </a>
      ))
    }
  </nav>
  <div class="site-header__tools">
    <button
      class="theme-toggle"
      type="button"
      data-theme-toggle
      aria-label="切换到白天模式"
      aria-pressed="true"
      title="切换到白天模式"
    >
      <Sun class="theme-icon theme-icon-sun" size={18} stroke-width={2} aria-hidden="true" />
      <Moon class="theme-icon theme-icon-moon" size={18} stroke-width={2} aria-hidden="true" />
    </button>
  </div>
</header>
