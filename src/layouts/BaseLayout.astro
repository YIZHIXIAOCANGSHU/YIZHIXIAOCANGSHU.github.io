---
import SiteHeader from '@components/SiteHeader.astro';
import { site } from '@data/site';
import '@styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  pageType?: 'website' | 'article';
  structuredData?: Record<string, unknown> | Record<string, unknown>[];
  wide?: boolean;
  flush?: boolean;
}

const {
  title,
  description = site.description,
  image = '/images/competitions/robomaster/hero-assembled.jpg',
  pageType = 'website',
  structuredData,
  wide = false,
  flush = false,
} = Astro.props;

const pageTitle = title ? `${title} | ${site.title}` : site.title;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin).href;
const socialImage = new URL(image, Astro.site ?? Astro.url.origin).href;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/jpeg" href="/images/new_tou_xiang.jpg" />
    <link rel="apple-touch-icon" href="/images/new_tou_xiang.jpg" />
    <meta property="og:locale" content="zh_CN" />
    <meta property="og:type" content={pageType} />
    <meta property="og:site_name" content={site.title} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={socialImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <title>{pageTitle}</title>
    <script is:inline>
      (() => {
        try {
          const savedTheme = localStorage.getItem('theme');
          document.documentElement.dataset.theme = savedTheme === 'light' ? 'light' : 'dark';
        } catch {
          document.documentElement.dataset.theme = 'dark';
        }
      })();
    </script>
    {structuredData && <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />}
  </head>
  <body>
    <a class="skip-link" href="#main-content">跳到正文</a>
    <SiteHeader currentPath={Astro.url.pathname} />
    <main id="main-content" class:list={['page-shell', wide && 'page-shell--wide', flush && 'page-shell--flush']}>
      <slot />
    </main>
    <footer class="site-footer">
      <span>© {new Date().getFullYear()} 贺禄文</span>
      <span>Built with Astro</span>
    </footer>
    <script is:inline>
      (() => {
        const root = document.documentElement;
        const toggle = document.querySelector('[data-theme-toggle]');
        if (!toggle) return;

        const updateToggle = () => {
          const isDark = root.dataset.theme !== 'light';
          const nextLabel = isDark ? '切换到白天模式' : '切换到夜晚模式';
          toggle.setAttribute('aria-label', nextLabel);
          toggle.setAttribute('title', nextLabel);
          toggle.setAttribute('aria-pressed', String(isDark));
        };

        const applyTheme = (theme) => {
          root.dataset.theme = theme;
          try {
            localStorage.setItem('theme', theme);
          } catch {
            // Keep theme switching available when storage is blocked.
          }
          updateToggle();
        };

        updateToggle();
        toggle.addEventListener('click', () => {
          applyTheme(root.dataset.theme === 'light' ? 'dark' : 'light');
        });
      })();
    </script>
  </body>
</html>
