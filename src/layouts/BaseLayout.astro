---
import SiteHeader from '@components/SiteHeader.astro';
import { site } from '@data/site';
import '@styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  pageType?: 'website' | 'article';
  structuredData?: Record<string, unknown> | Record<string, unknown>[];
  wide?: boolean;
  flush?: boolean;
}

const {
  title,
  description = site.description,
  image = '/images/competitions/robomaster/hero-assembled.jpg',
  pageType = 'website',
  structuredData,
  wide = false,
  flush = false,
} = Astro.props;

const pageTitle = title ? `${title} | ${site.title}` : site.title;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin).href;
const socialImage = new URL(image, Astro.site ?? Astro.url.origin).href;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/jpeg" href="/images/new_tou_xiang.jpg" />
    <link rel="apple-touch-icon" href="/images/new_tou_xiang.jpg" />
    <meta property="og:locale" content="zh_CN" />
    <meta property="og:type" content={pageType} />
    <meta property="og:site_name" content={site.title} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={socialImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <title>{pageTitle}</title>
    {structuredData && <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />}
  </head>
  <body>
    <a class="skip-link" href="#main-content">跳到正文</a>
    <SiteHeader currentPath={Astro.url.pathname} />
    <main id="main-content" class:list={['page-shell', wide && 'page-shell--wide', flush && 'page-shell--flush']}>
      <slot />
    </main>
    <footer class="site-footer">
      <span>© {new Date().getFullYear()} Luwen He</span>
      <span>Built with Astro</span>
    </footer>
  </body>
</html>
